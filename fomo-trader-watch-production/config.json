  "alertTypes": [
    "buy"
  ],
  "minUsdHint": 3000,
  "seenMax": 5000,
  "heartbeatEveryMs": 30000,
  "reconnect": {
    "initialMs": 2000,
    "maxMs": 60000
  },
  "seedSeenOnEmpty": true,
  "seedCreditsNote": "One REST GET /v2/alerts per NEW trader (~125 credits) only when that handle is not yet in state/seeded-traders.json, to avoid replaying historical buys as live alerts.",
  "transferFilter": {
    "enabled": true,
    "rules": [
      "Skip if type/alertType is transfer (or deposit/receive)",
      "Skip if transferId set and swapId empty",
      "Skip if text looks like received/transfer-in without bought",
      "When tradeId present: GET /v2/trades/{id}; skip if transferredInAmount>0 and boughtAmount<=0 (or transfers-only, no swaps)"
    ],
    "verifyTradeDetail": true,
    "verifyCreditCostHint": 250
  },
  "portfolioPct": {
    "enabled": true,
    "balancesPath": "/v2/users/{handle}/balances",
    "creditCostHint": 250,
    "fallbackWhenNoTotal": "minUsdHint",
    "fallbackNote": "If balances totalValueUsd unavailable: require buyUsd >= minUsdHint (3000) and annotate 总资产未知; still apply new-position best-effort.",
    "newPositionNote": "After buy, priorEst = max(0, holding.valueUsd - buyUsd). New if no holding / amount~0 / priorEst < max($1, 5% of buy). If balances fail: alert with 是否新仓未知 when pct/fallback passes."
  },
  "wsNote": "One process opens one WS per enabled trader (type=buy, 0 credits each)."
}
