# Environment Configuration Example
# Copy to .env and fill in your credentials

# GMGN API (Required for on-chain discovery)
# Get read-only key from GMGN.AI dashboard
GMGN_API_KEY=

# X/Twitter Monitoring (Optional - Choose provider based on budget)

# Cheap third-party (3-5 min poll, recommended for research)
# SOCIALDATA_API_KEY=your-socialdata-api-key
# X_PROVIDER=socialdata
# X_POLL_INTERVAL_MS=240000

# Or official (2 min poll, expensive)
# X_BEARER_TOKEN=your-twitter-api-v2-bearer-token
# X_PROVIDER=official
# X_POLL_INTERVAL_MS=120000

# X Monitoring Settings
# X_MIN_FOLLOWERS=10000
# X_COMPETITION_WINDOW_HOURS=6
# X_COMPETITION_THRESHOLD=60
# X_SOFT_MENTION_TIERS=official,founder,chain_lead

# Webhook Notifications (Optional)
# WEBHOOK_URL=https://your-webhook-endpoint.com/alerts
# WEBHOOK_MIN_TIER=hot

# Chain & Discovery
# RADAR_CHAIN=sol
# DISCOVERY_MIN_MARKET_CAP=10000
# DISCOVERY_MAX_MARKET_CAP=200000

# Server
# RADAR_PORT=3791
